(export (version "E")
  (design
    (source "gems-pcb2-power")
    (date "2026-09-06")
    (tool "hand-authored starter for gems_t4 2-PCB build - VERIFY in KiCad"))
  (components
    (comp (ref "J2") (value "12V_DC_in") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"))
    (comp (ref "D2") (value "SS54") (footprint "Diode_SMD:D_SMC"))
    (comp (ref "F2") (value "Fuse_3-5A") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"))
    (comp (ref "SW1") (value "PWR_toggle") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"))
    (comp (ref "SW2") (value "IGN_toggle") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"))
    (comp (ref "LED1") (value "PWR_LED_DNP") (footprint "LED_SMD:LED_0805_2012Metric"))
    (comp (ref "R2") (value "2.2k_DNP") (footprint "Resistor_SMD:R_0805_2012Metric"))
    (comp (ref "D3") (value "TVS_SMBJ24A_DNP") (footprint "Diode_SMD:D_SMB"))
    (comp (ref "J3") (value "4pin_to_PCB1") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical"))
    (comp (ref "J4") (value "8pin_to_ECU") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x08_P2.54mm_Vertical")))
  (nets
    (net (code "1") (name "+12IN")
      (node (ref "J2") (pin "1"))
      (node (ref "D2") (pin "2")))
    (net (code "2") (name "D2_OUT")
      (node (ref "D2") (pin "1"))
      (node (ref "F2") (pin "1")))
    (net (code "3") (name "FUSED")
      (node (ref "F2") (pin "2"))
      (node (ref "SW1") (pin "1")))
    (net (code "4") (name "V12S")
      (node (ref "SW1") (pin "2"))
      (node (ref "J3") (pin "1"))
      (node (ref "J4") (pin "3"))
      (node (ref "SW2") (pin "1"))
      (node (ref "R2") (pin "1"))
      (node (ref "D3") (pin "1")))
    (net (code "5") (name "IGN_P8")
      (node (ref "SW2") (pin "2"))
      (node (ref "J4") (pin "4")))
    (net (code "6") (name "GND")
      (node (ref "J2") (pin "2"))
      (node (ref "J3") (pin "2"))
      (node (ref "J4") (pin "5"))
      (node (ref "J4") (pin "6"))
      (node (ref "J4") (pin "7"))
      (node (ref "J4") (pin "8"))
      (node (ref "LED1") (pin "2"))
      (node (ref "D3") (pin "2")))
    (net (code "7") (name "LED_A")
      (node (ref "R2") (pin "2"))
      (node (ref "LED1") (pin "1")))
    (net (code "8") (name "K")
      (node (ref "J3") (pin "3"))
      (node (ref "J4") (pin "2")))
    (net (code "9") (name "L")
      (node (ref "J3") (pin "4"))
      (node (ref "J4") (pin "1")))))
