# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.spec                 # stray auto-generated PyInstaller specs...
!packaging/*.spec      # ...but keep our intentional packaging spec

# --- Test / type / lint caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- ECU data / runtime artifacts ---
*.bin                  # EPROM / calibration dumps
backups/               # coding-write backups
scratch_shots/         # rendered screen PNGs (dev only)

# --- OS / OneDrive / editor junk ---
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
.DS_Store
*.swp
*~
.idea/
*.code-workspace

# --- Arduino / firmware build output ---
firmware/**/build/
*.elf
*.uf2

# WiFi credentials for the Pico WiFi firmware (never commit real secrets)
firmware/pico_kline_wifi/wifi_secrets.h
wifi_secrets.h
**/wifi_secrets.h

# Built React front-end (generated by frontend/npm run build)
gems_t4/app/web/static/


# RAVE PDFs (Land Rover IP) - local reference only, never publish
docs/rave/

# 10AS connector graphic (third-party; kept local like the RAVE PDFs)
docs/img/10as-central-locking-connections.png

# Bench-script runtime capture output (regenerable)
bench/*.state.json
bench/*.log
bench/*.csv
bench/*.bin

# --- Board 2: third-party library models we may not redistribute (SamacSys licence, public repo) ---
hardware/board2-pcb/board2.3dshapes/OQ1632510000G.stp
hardware/board2-pcb/board2.pretty/SHDRRA16W80P0X381_1X16_6215X920X745P.kicad_mod
hardware/board2-pcb/board2.pretty/OQ1632510000G_1x16_P3.81mm_RA_PinsReversed.kicad_mod
hardware/board2-pcb/jMKyryrC5T7A.pdf
# Same Sky TBP02R1-381-16BE 3D model downloaded from a distributor (vendor-licensed STEP): keep local
hardware/board2-pcb/board2.3dshapes/TBP02R1-381-16BE.step

# KiCad lock files
*.lck

# Harwin M20-9980546 3D model (Ultra Librarian, vendor-licensed) and the pins-removed derivatives: keep local
hardware/board2-pcb/board2.3dshapes/M20-9980546_KeyRowRemoved.glb
hardware/board2-pcb/board2.3dshapes/M20-9980546_KeyRowRemoved.wrl
