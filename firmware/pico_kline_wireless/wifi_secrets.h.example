/*
 * wifi_secrets.h — YOUR WiFi credentials for pico_kline_wireless.
 *
 * SETUP: copy this file to `wifi_secrets.h` (same folder) and fill in your
 * network(s). `wifi_secrets.h` is git-ignored, so your credentials never get
 * committed. This `.example` template is safe to commit.
 *
 *   cp wifi_secrets.h.example wifi_secrets.h    # then edit wifi_secrets.h
 *
 * NOTE: this combined firmware also serves Bluetooth, which needs NO
 * credentials — so even if WiFi never connects, the Bluetooth SPP link still
 * works. WiFi is 2.4 GHz only (the CYW43 can't see a 5 GHz-only SSID).
 */
#pragma once

/* ── Option A: MULTIPLE networks (recommended) ────────────────────────────
 * On boot it scans and connects to whichever known network is IN RANGE with the
 * STRONGEST signal. Keep the trailing backslash "\" on every line EXCEPT the
 * last. All must be 2.4 GHz.
 */
#define WIFI_NETWORKS \
  X("YOUR_2G4_WIFI_NAME", "YOUR_WIFI_PASSWORD") \
  X("YOUR_PHONE_HOTSPOT", "HOTSPOT_PASSWORD")

/* ── Option B: ONE network (simpler) ──────────────────────────────────────
 * Delete the WIFI_NETWORKS block above and uncomment these instead:
 */
// #define WIFI_SSID  "YOUR_2G4_WIFI_NAME"
// #define WIFI_PASS  "YOUR_WIFI_PASSWORD"
