/*
 * wifi_secrets.h — YOUR WiFi credentials for pico_kline_wifi.
 *
 * SETUP: copy this file to `wifi_secrets.h` (same folder) and fill in your
 * network's SSID and password. `wifi_secrets.h` is git-ignored, so your
 * credentials never get committed. This `.example` template is safe to commit.
 *
 *   cp wifi_secrets.h.example wifi_secrets.h    # then edit wifi_secrets.h
 *
 * The Pico 2 W joins a normal 2.4 GHz network (the CYW43 is 2.4 GHz only — it
 * will NOT see a 5 GHz-only SSID). Use your 2.4 GHz band/SSID.
 */
#pragma once

#define WIFI_SSID  "YOUR_2G4_WIFI_NAME"
#define WIFI_PASS  "YOUR_WIFI_PASSWORD"
